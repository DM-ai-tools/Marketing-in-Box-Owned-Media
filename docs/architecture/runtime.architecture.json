  "cards": [
    {
      "dot": "cyan",
      "title": "Stage run",
      "items": [
        "The operator starts one asset stage in the Pipeline UI.",
        "Vite proxies same-origin /api calls to the FastAPI process.",
        "POST /pipeline/generate/{asset_id}/stream returns Markdown deltas over SSE.",
        "Approving the draft appends a new ContextEntry version on the run."
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundary",
      "items": [
        "Email and password sessions travel in an httpOnly cookie.",
        "ANTHROPIC_API_KEY, CONTEXT_DEV_API_KEY, and OPENAI_API_KEY are read only on the server.",
        "The browser receives vendor results through FastAPI routes."
      ]
    },
    {
      "dot": "amber",
      "title": "Vendors and store",
      "items": [
        "Context.dev supplies scrape, search, brand, styleguide, fonts, and screenshots.",
        "OpenAI gpt-image-2 bytes are stored in MediaAsset and served at GET /media/{id}.",
        "Firecrawl and Brandfetch fill brand gaps; SociaVault supplies social-audit posts.",
        "PostgreSQL holds runs, approved context, chat sessions, and those image bytes."
      ]
    }
  ]
